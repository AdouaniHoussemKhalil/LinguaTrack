# Copier ce fichier en app/.env et renseigner les valeurs (app/.env n'est jamais commité).

# Base de données : SQLite par défaut ; en Docker, docker-compose fournit l'URL PostgreSQL.
DATABASE_URL=sqlite:///./linguatrack.db
# SQL_ECHO=true   # affiche les requêtes SQL (débogage)

# Service d'authentification (auth-web-app-api) — obligatoire.
# Identifiants de l'application déclarée dans son dashboard (Applications → fiche de l'application).
# Le secret donne accès à tous les comptes : il ne quitte jamais ce fichier ni le serveur.
AUTH_API_URL=http://localhost:8080
AUTH_APP_ID=
AUTH_APP_SECRET=
# AUTH_TIMEOUT=30
# Cookies de session réservés à HTTPS : true en production
# COOKIE_SECURE=false

# Clé API Mistral (https://console.mistral.ai)
MISTRAL_API_KEY=
# Modèle Mistral ; l'offre actuelle n'ouvre que ministral-8b-latest / ministral-3b-latest
# MISTRAL_MODEL=ministral-8b-latest

# Ordre des fournisseurs d'analyse (les non configurés sont ignorés)
# LLM_PROVIDERS=mistral,ollama,claude

# Facultatif et payant : Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Modèle local via Ollama (gratuit, lent sur CPU) ; OLLAMA_MODEL= (vide) pour le désactiver.
# En Docker, utiliser OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=deepseek-r1:1.5b
# OLLAMA_TIMEOUT=180

# Nombre maximal d'analyses par utilisateur ; 0 = sans limite
# ANALYSES_PER_HOUR=30
# ANALYSES_PER_DAY=200

# Origines autorisées par CORS, séparées par des virgules
CORS_ORIGINS=http://localhost:5173
