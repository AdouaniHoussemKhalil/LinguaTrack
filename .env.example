# Copier ce fichier en app/.env et renseigner les valeurs (app/.env n'est jamais commité).

# Base de données : SQLite par défaut ; en Docker, docker-compose fournit l'URL PostgreSQL.
DATABASE_URL=sqlite:///./linguatrack.db
# SQL_ECHO=true   # affiche les requêtes SQL (débogage)

# JWT — générer une clé : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Clé API Mistral (https://console.mistral.ai)
MISTRAL_API_KEY=

# Ordre des fournisseurs d'analyse (les non configurés sont ignorés)
# LLM_PROVIDERS=mistral,ollama,claude

# Facultatif et payant : Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Modèle local via Ollama (gratuit, lent sur CPU) ; OLLAMA_MODEL= (vide) pour le désactiver.
# En Docker, utiliser OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=deepseek-r1:1.5b
# OLLAMA_TIMEOUT=180

# Origines autorisées par CORS, séparées par des virgules
CORS_ORIGINS=http://localhost:5173
